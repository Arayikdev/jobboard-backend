# ===========================
# BASE IMAGE
# ===========================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# ===========================
# INSTALL BUILD TOOLCHAIN
# ===========================
RUN apt-get update && apt-get install -y \
    g++ cmake make git wget curl pkg-config ninja-build \
    libsasl2-dev libssl-dev libcurl4-openssl-dev ca-certificates \
    python3 libpython3-dev libboost-all-dev \
    build-essential

# ===========================
# INSTALL libmongoc (C driver)
# ===========================
RUN apt-get update && apt-get install -y \
    libmongoc-dev libbson-dev

# ===========================
# INSTALL MongoDB C++ Driver (mongocxx + bsoncxx)
# ===========================
WORKDIR /tmp

RUN wget https://github.com/mongodb/mongo-cxx-driver/releases/download/r3.8.0/mongo-cxx-driver-r3.8.0.tar.gz && \
    tar -xzf mongo-cxx-driver-r3.8.0.tar.gz && \
    cd mongo-cxx-driver-r3.8.0/build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DBSONCXX_POLY_USE_MNMLSTC=1 && \
    cmake --build . --target install

# ===========================
# COPY PROJECT
# ===========================
WORKDIR /app
COPY . .

# ===========================
# BUILD YOUR PROJECT
# ===========================
RUN mkdir build && cd build && cmake .. && make -j$(nproc)

# ===========================
# RUNTIME
# ===========================
WORKDIR /app/build
EXPOSE 8080

CMD ["./server"]
