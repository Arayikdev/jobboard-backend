FROM ubuntu:22.04 as builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    g++ cmake make git wget \
    pkg-config libc6-dev libssl-dev libsasl2-dev libcurl4-openssl-dev \
    python3 python3-pip \
    ca-certificates

# Install MongoDB C++ Driver (bsoncxx + mongocxx)
WORKDIR /tmp

RUN wget https://github.com/mongodb/mongo-cxx-driver/releases/download/r3.8.0/mongo-cxx-driver-r3.8.0.tar.gz
RUN tar -xzf mongo-cxx-driver-r3.8.0.tar.gz
WORKDIR /tmp/mongo-cxx-driver-r3.8.0/build

RUN cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local
RUN cmake --build . --target install

# BUILD YOUR APP
WORKDIR /app
COPY . .

RUN mkdir build && cd build && cmake .. && make -j$(nproc)

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    libssl-dev libsasl2-dev libcurl4-openssl-dev ca-certificates

COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /usr/local/include /usr/local/include

WORKDIR /app
COPY --from=builder /app/build/server /app/server

RUN ldconfig

EXPOSE 8080
CMD ["./server"]
