# ========== Stage 1: Build ==========
FROM ubuntu:22.04 AS builder

# Install required tools
RUN apt-get update && apt-get install -y \
    g++ \
    cmake \
    make \
    git \
    pkg-config \
    libssl-dev \
    libsasl2-dev \
    libcurl4-openssl-dev \
    ca-certificates \
    wget

# Install MongoDB C++ driver (mongocxx)
RUN apt-get update && apt-get install -y libmongocxx-dev libbsoncxx-dev

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Build project
RUN mkdir build && cd build && cmake .. && make -j$(nproc)

# ========== Stage 2: Runtime ==========
FROM ubuntu:22.04

# Install dependencies required for runtime
RUN apt-get update && apt-get install -y \
    libssl-dev \
    libsasl2-dev \
    libcurl4-openssl-dev \
    libmongocxx-dev \
    libbsoncxx-dev \
    ca-certificates

WORKDIR /app

# Copy binaries from builder
COPY --from=builder /app/build/server /app/server

EXPOSE 8080

CMD ["./server"]
